terraform {
  required_providers {
    coder = {
      source = "coder/coder"
    }
    docker = {
      source = "kreuzwerker/docker"
    }
  }
}

provider "coder" {}
provider "docker" {}

data "coder_workspace" "me" {}
data "coder_workspace_owner" "me" {}

# ─── Docker image (Ubuntu base — deps installed in startup) ─────

resource "docker_image" "workspace" {
  name = "ubuntu:24.04"
}

# ─── Container ───────────────────────────────────────────────────

resource "docker_container" "workspace" {
  count = data.coder_workspace.me.start_count
  name  = "coder-${data.coder_workspace_owner.me.name}-${lower(data.coder_workspace.me.name)}"
  image = docker_image.workspace.image_id

  env = [
    "CODER_AGENT_TOKEN=${coder_agent.main.token}",
  ]

  host {
    host = "host.docker.internal"
    ip   = "host-gateway"
  }

  # Persistent home directory across workspace restarts
  volumes {
    volume_name    = "coder-${data.coder_workspace_owner.me.name}-${lower(data.coder_workspace.me.name)}-home"
    container_path = "/home/coder"
    read_only      = false
  }

  # Mount host org config + pre-cloned repos (written by cloud-init during VPS provisioning)
  volumes {
    host_path      = "/opt/egregore"
    container_path = "/opt/egregore"
    read_only      = true
  }

  # Install curl first (needed for agent download), create user, then start agent AS coder
  command = ["sh", "-c", <<-EOT
    # Install curl (minimal — needed for coder agent download)
    apt-get update -qq && apt-get install -y -qq curl sudo > /dev/null 2>&1

    # Create user if not exists
    if ! id coder >/dev/null 2>&1; then
      useradd -m -s /bin/bash coder
      mkdir -p /etc/sudoers.d
      echo "coder ALL=(ALL) NOPASSWD:ALL" > /etc/sudoers.d/coder
      chmod 0440 /etc/sudoers.d/coder
    fi

    # Fix DNS for Docker
    echo "nameserver 8.8.8.8" > /etc/resolv.conf

    # Ensure coder owns its home directory (Docker volume starts as root)
    chown coder:coder /home/coder

    # Start the Coder agent as coder user (so terminal opens as coder, not root)
    exec su coder -c '${replace(coder_agent.main.init_script, "/localhost|127\\.0\\.0\\.1/", "host.docker.internal")}'
  EOT
  ]
}

# ─── Coder agent ─────────────────────────────────────────────────

resource "coder_agent" "main" {
  os   = "linux"
  arch = "arm64"
  dir  = "/home/coder"

  display_apps {
    vscode                = false
    vscode_insiders       = false
    web_terminal          = true
    ssh_helper            = true
    port_forwarding_helper = true
  }

  startup_script_behavior = "non-blocking"

  startup_script = <<-EOT
    #!/bin/bash
    set -e

    echo "=== Startup begin ==="

    # ─── Phase 1: System deps ─────────────────────────────────────
    if ! command -v git &>/dev/null; then
      echo "Installing system deps..."
      sudo apt-get update -qq
      sudo apt-get install -y -qq git jq ca-certificates gnupg zsh unzip > /dev/null 2>&1

      # GitHub CLI
      curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg | sudo gpg --dearmor -o /usr/share/keyrings/githubcli-archive-keyring.gpg
      echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" | sudo tee /etc/apt/sources.list.d/github-cli.list > /dev/null
      sudo apt-get update -qq && sudo apt-get install -y -qq gh > /dev/null 2>&1

      # Node.js 20
      curl -fsSL https://deb.nodesource.com/setup_20.x | sudo bash - > /dev/null 2>&1
      sudo apt-get install -y -qq nodejs > /dev/null 2>&1
      echo "System deps installed"
    else
      echo "System deps already present"
    fi

    # ─── Phase 2: Claude Code ─────────────────────────────────────
    echo "Installing Claude Code..."
    curl -fsSL https://claude.ai/install.sh | bash 2>&1 || echo "Claude Code install returned non-zero (may be ok)"

    CLAUDE_BIN=""
    if [ -f "$HOME/.local/bin/claude" ]; then
      CLAUDE_BIN="$HOME/.local/bin/claude"
    elif [ -f "$HOME/.claude/bin/claude" ]; then
      CLAUDE_BIN="$HOME/.claude/bin/claude"
    fi
    echo "Claude binary: $CLAUDE_BIN"

    if [ -n "$CLAUDE_BIN" ]; then
      sudo ln -sf "$CLAUDE_BIN" /usr/local/bin/claude 2>/dev/null || true
    fi

    # ─── Phase 3: Git credentials (org-level token) ───────────────
    # Uses the org's GitHub token stored on the VPS during provisioning.
    # All git operations (clone, pull, push) use this token transparently.
    # No per-user external auth needed.
    if [ -f /opt/egregore/github-token ]; then
      GH_TOKEN=$(cat /opt/egregore/github-token)
      if [ -n "$GH_TOKEN" ]; then
        git config --global credential.helper 'store'
        echo "https://x-access-token:$${GH_TOKEN}@github.com" > /home/coder/.git-credentials
        chmod 600 /home/coder/.git-credentials
        chown coder:coder /home/coder/.git-credentials
        echo "Git credentials configured"
      fi
    fi

    # Set git identity from Coder workspace owner
    CODER_USER="${data.coder_workspace_owner.me.name}"
    git config --global user.name "$CODER_USER"
    git config --global user.email "$${CODER_USER}@users.noreply.github.com"

    # ─── Phase 4: Clone/copy repos + write config ─────────────────
    ORG_CONFIG="/opt/egregore/org-config.json"
    if [ -f "$ORG_CONFIG" ] && command -v jq &>/dev/null; then
      ORG_SLUG=$(jq -r '.org_slug' "$ORG_CONFIG")
      FORK_URL=$(jq -r '.fork_url' "$ORG_CONFIG")
      MEMORY_URL=$(jq -r '.memory_url' "$ORG_CONFIG")
      API_URL=$(jq -r '.api_url' "$ORG_CONFIG")
      API_KEY=$(jq -r '.egregore_api_key' "$ORG_CONFIG")
      ORG_NAME=$(jq -r '.org_name' "$ORG_CONFIG")
      GITHUB_ORG=$(jq -r '.github_org' "$ORG_CONFIG")
      REPO_NAME=$(jq -r '.repo_name' "$ORG_CONFIG")
      MANAGED_REPOS=$(jq -r '.managed_repos // ""' "$ORG_CONFIG")

      # Copy pre-cloned repos (instant, no network needed)
      # Falls back to git clone if pre-cloned repos don't exist
      if [ ! -d "/home/coder/egregore/.git" ]; then
        if [ -d "/opt/egregore/repos/egregore/.git" ]; then
          echo "Copying pre-cloned egregore repo..."
          cp -a /opt/egregore/repos/egregore /home/coder/egregore
          chown -R coder:coder /home/coder/egregore
          # Update remote URL (pre-clone may have different URL)
          cd /home/coder/egregore
          git remote set-url origin "$FORK_URL" 2>/dev/null || true
          cd /home/coder
        elif [ "$FORK_URL" != "null" ] && [ -n "$FORK_URL" ]; then
          echo "Cloning egregore repo..."
          git clone "$FORK_URL" /home/coder/egregore 2>&1 || echo "Clone failed"
        fi
      fi

      if [ ! -d "/home/coder/memory/.git" ]; then
        if [ -d "/opt/egregore/repos/memory/.git" ]; then
          echo "Copying pre-cloned memory repo..."
          cp -a /opt/egregore/repos/memory /home/coder/memory
          chown -R coder:coder /home/coder/memory
          cd /home/coder/memory
          git remote set-url origin "$MEMORY_URL" 2>/dev/null || true
          cd /home/coder
        elif [ "$MEMORY_URL" != "null" ] && [ -n "$MEMORY_URL" ]; then
          echo "Cloning memory repo..."
          git clone "$MEMORY_URL" /home/coder/memory 2>&1 || echo "Clone failed"
        fi
      fi

      # Clone managed repos (no pre-clone for these yet)
      if [ -n "$MANAGED_REPOS" ] && [ "$MANAGED_REPOS" != "null" ]; then
        IFS=',' read -ra REPOS <<< "$MANAGED_REPOS"
        for repo in "$${REPOS[@]}"; do
          repo=$(echo "$repo" | xargs)
          [ -z "$repo" ] && continue
          if [ ! -d "/home/coder/$repo/.git" ]; then
            echo "Cloning $repo..."
            git clone "https://github.com/$${GITHUB_ORG}/$repo.git" "/home/coder/$repo" 2>&1 || true
          fi
        done
      fi

      # Memory symlink
      if [ -d "/home/coder/memory" ] && [ -d "/home/coder/egregore" ]; then
        ln -sfn /home/coder/memory /home/coder/egregore/memory
      fi

      # Build managed repos JSON
      MANAGED_JSON="[]"
      if [ -n "$MANAGED_REPOS" ] && [ "$MANAGED_REPOS" != "null" ]; then
        MANAGED_JSON=$(echo "$MANAGED_REPOS" | tr ',' '\n' | sed 's/^[[:space:]]*//;s/[[:space:]]*$//' | awk 'NF{printf "%s\"%s\"", (NR>1?",":""), $0}' | sed 's/^/[/;s/$/]/')
      fi

      # Write egregore.json
      if [ -d "/home/coder/egregore" ]; then
        cat > /home/coder/egregore/egregore.json <<EJSON
{
  "org_name": "$ORG_NAME",
  "github_org": "$GITHUB_ORG",
  "memory_repo": "$MEMORY_URL",
  "api_url": "$API_URL",
  "repo_name": "$REPO_NAME",
  "slug": "$ORG_SLUG",
  "repos": $MANAGED_JSON
}
EJSON
      fi

      # Write .env (use org token for GITHUB_TOKEN — works for all git ops)
      if [ -d "/home/coder/egregore" ]; then
        GH_TOKEN_FOR_ENV=""
        if [ -f /opt/egregore/github-token ]; then
          GH_TOKEN_FOR_ENV=$(cat /opt/egregore/github-token)
        fi
        cat > /home/coder/egregore/.env <<EENV
GITHUB_TOKEN=$GH_TOKEN_FOR_ENV
EGREGORE_API_KEY=$API_KEY
ANTHROPIC_API_KEY=
EENV
        chmod 600 /home/coder/egregore/.env
      fi

      # Commit egregore.json locally
      if [ -d "/home/coder/egregore/.git" ]; then
        cd /home/coder/egregore
        git add egregore.json 2>/dev/null || true
        git diff --cached --quiet 2>/dev/null || git commit -m "Configure workspace for $ORG_NAME" --quiet 2>/dev/null || true
        cd /home/coder
      fi

      echo "Repos cloned and configured"
    fi

    # ─── Phase 5: Shell config ────────────────────────────────────

    # Ensure .bash_profile sources .bashrc
    if [ ! -f /home/coder/.bash_profile ]; then
      cat > /home/coder/.bash_profile <<'PROFILEEOF'
if [ -f "$HOME/.bashrc" ]; then
  . "$HOME/.bashrc"
fi
PROFILEEOF
      chown coder:coder /home/coder/.bash_profile
    fi

    # PATH
    if ! grep -q 'local/bin' /home/coder/.bashrc 2>/dev/null; then
      echo 'export PATH="$HOME/.local/bin:$HOME/.claude/bin:$PATH"' >> /home/coder/.bashrc
    fi

    # ─── Bootstrap (auto-start Egregore on terminal open) ─────────
    cat > /home/coder/.egregore-bootstrap.sh <<'BOOTEOF'
#!/bin/bash
# EGREGORE_BOOTSTRAP_v7 — auto-start Claude in egregore dir

# Convenience command
egregore() {
  if [ -d "$HOME/egregore" ]; then
    cd ~/egregore && claude "start"
  else
    echo "Workspace not ready. Restart from the Coder dashboard."
  fi
}

# Auto-start on first interactive login
if [ -z "$EGREGORE_STARTED" ] && [ -t 0 ]; then
  export EGREGORE_STARTED=1
  export PATH="$HOME/.local/bin:$HOME/.claude/bin:$PATH"

  # Wait for startup script to finish (deps + repos)
  _ready() {
    command -v jq &>/dev/null && \
    { [ -f "$HOME/.local/bin/claude" ] || [ -f "$HOME/.claude/bin/claude" ] || [ -f "/usr/local/bin/claude" ]; } && \
    [ -d "$HOME/egregore/.git" ]
  }

  if ! _ready; then
    echo "Preparing workspace..."
    for i in $(seq 1 120); do
      _ready && break
      sleep 2
    done
  fi

  # Start Egregore
  if [ -d "$HOME/egregore" ] && command -v claude &>/dev/null; then
    cd ~/egregore
    exec claude "start"
  else
    echo ""
    echo "  Workspace setup incomplete."
    echo "  Type 'egregore' to retry, or restart from the Coder dashboard."
    echo ""
  fi
fi
BOOTEOF
    chown coder:coder /home/coder/.egregore-bootstrap.sh
    chmod +x /home/coder/.egregore-bootstrap.sh

    # Clean old inline bootstrap from .bashrc
    if grep -q "EGREGORE_BOOTSTRAP" /home/coder/.bashrc 2>/dev/null && ! grep -q "egregore-bootstrap.sh" /home/coder/.bashrc 2>/dev/null; then
      MARKER_LINE=$(grep -n "# ─── Egregore workspace bootstrap" /home/coder/.bashrc 2>/dev/null | head -1 | cut -d: -f1)
      if [ -n "$MARKER_LINE" ]; then
        KEEP_TO=$((MARKER_LINE - 2))
        if [ "$KEEP_TO" -gt 0 ]; then
          head -n "$KEEP_TO" /home/coder/.bashrc > /tmp/.bashrc.clean
        else
          echo "" > /tmp/.bashrc.clean
        fi
        mv /tmp/.bashrc.clean /home/coder/.bashrc
      fi
    fi

    # Source line (idempotent)
    if ! grep -q 'egregore-bootstrap.sh' /home/coder/.bashrc 2>/dev/null; then
      echo '' >> /home/coder/.bashrc
      echo '# Egregore bootstrap' >> /home/coder/.bashrc
      echo '[ -f "$HOME/.egregore-bootstrap.sh" ] && source "$HOME/.egregore-bootstrap.sh"' >> /home/coder/.bashrc
    fi
    chown coder:coder /home/coder/.bashrc

    # ─── Signal: startup complete ─────────────────────────────────
    touch /home/coder/.egregore-ready
    echo "=== Startup complete ==="
  EOT

  metadata {
    key          = "org"
    display_name = "Egregore"
    script       = "jq -r '.org_name' /home/coder/egregore/egregore.json 2>/dev/null || echo 'initializing...'"
    interval     = 30
  }

  metadata {
    key          = "branch"
    display_name = "Branch"
    script       = "cd /home/coder/egregore 2>/dev/null && git branch --show-current 2>/dev/null || echo '-'"
    interval     = 10
  }
}
